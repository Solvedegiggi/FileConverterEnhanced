<Window x:Class="FileConverter.Views.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:project="clr-namespace:FileConverter.Properties"
        xmlns:controls="clr-namespace:FileConverter.Views.Controls"
        xmlns:jobControls="clr-namespace:FileConverter.Controls"
        xmlns:workspaces="clr-namespace:FileConverter.ViewModels.Workspaces"
        xmlns:workspaceViews="clr-namespace:FileConverter.Views.Workspaces"
        DataContext="{Binding Hub, Source={StaticResource Locator}}"
        Title="File Converter Enhanced"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="HubWindow_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Width="212">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource PrimaryActionBrush}" Margin="0,0,10,0">
                        <TextBlock Text="FC" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="File Converter" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Search bar -->
                <Grid Width="340" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="14,0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource ModernInputTextBox}"
                             Padding="10,7,30,7"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Static project:Resources.HubSearchPlaceholder}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="✕" Width="22" Height="22" HorizontalAlignment="Right" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Visibility="{Binding SearchQuery, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=Collapsed}"
                            Click="ClearSearch_Click" />
                </Grid>

                <!-- Right actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Style="{StaticResource HubSecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0"
                            ToolTip="{x:Static project:Resources.HubToggleThemeTooltip}"
                            Command="{Binding ToggleThemeCommand}">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🌙" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Text" Value="☀" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Content="?" Width="34" Height="34"
                            Style="{StaticResource HubSecondaryButton}" Padding="0"
                            Command="{Binding OpenHelpCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,4">
                    <Separator Margin="6,0,6,8" Background="{DynamicResource CardBorderBrush}" />
                    <Button Style="{StaticResource HubSecondaryButton}"
                            HorizontalContentAlignment="Left" Margin="0,2"
                            Content="{x:Static project:Resources.HubNavSettings}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Style="{StaticResource HubSecondaryButton}"
                            HorizontalContentAlignment="Left" Margin="0,2"
                            Content="{x:Static project:Resources.HubNavDiagnostics}"
                            Command="{Binding OpenDiagnosticsCommand}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton GroupName="HubNav" Style="{StaticResource HubNavButton}"
                                 Content="{x:Static project:Resources.HubNavHome}"
                                 IsChecked="{Binding IsHomeSelected, Mode=TwoWay}" />
                    <RadioButton GroupName="HubNav" Style="{StaticResource HubNavButton}"
                                 Content="{x:Static project:Resources.HubNavConverter}"
                                 IsChecked="{Binding IsConverterSelected, Mode=TwoWay}" />
                    <RadioButton GroupName="HubNav" Style="{StaticResource HubNavButton}"
                                 Content="{x:Static project:Resources.HubNavAllTools}"
                                 IsChecked="{Binding IsAllToolsSelected, Mode=TwoWay}" />
                    <RadioButton GroupName="HubNav" Style="{StaticResource HubNavButton}"
                                 IsChecked="{Binding IsQueueSelected, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static project:Resources.HubNavQueue}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" CornerRadius="10" Padding="7,1"
                                    Background="{DynamicResource PrimaryActionBrush}"
                                    Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                                <TextBlock Text="{Binding ActiveJobsCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="24">
            <controls:HomeGridView DataContext="{Binding HomeGrid}"
                                   Visibility="{Binding DataContext.IsHomeSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}" />

            <controls:UniversalConverterView DataContext="{Binding UniversalConverter}"
                                             Visibility="{Binding DataContext.IsConverterSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}" />

            <controls:AllToolsView Visibility="{Binding IsAllToolsSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}" />

            <!-- QUEUE SECTION -->
            <Grid Visibility="{Binding IsQueueSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{x:Static project:Resources.HubNavQueue}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource HubSecondaryButton}"
                            Content="{x:Static project:Resources.UniversalClearList}"
                            Command="{Binding ClearCompletedJobsCommand}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConversionJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <jobControls:ConversionJobControl Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- DEDICATED TOOL WORKSPACE -->
            <ContentControl Content="{Binding ActiveWorkspace}"
                            Visibility="{Binding IsWorkspaceActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type workspaces:PdfMergeWorkspaceViewModel}">
                        <workspaceViews:PdfMergeWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfSplitWorkspaceViewModel}">
                        <workspaceViews:PdfSplitWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfCompressWorkspaceViewModel}">
                        <workspaceViews:PdfCompressWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfRotateWorkspaceViewModel}">
                        <workspaceViews:PdfRotateWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfPageNumbersWorkspaceViewModel}">
                        <workspaceViews:PdfPageNumbersWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfToJpgWorkspaceViewModel}">
                        <workspaceViews:PdfToJpgWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:ImagesToPdfWorkspaceViewModel}">
                        <workspaceViews:ImagesToPdfWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:HtmlToPdfWorkspaceViewModel}">
                        <workspaceViews:HtmlToPdfWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfOcrWorkspaceViewModel}">
                        <workspaceViews:PdfOcrWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfToMarkdownWorkspaceViewModel}">
                        <workspaceViews:PdfToMarkdownWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:OfficeConversionWorkspaceViewModel}">
                        <workspaceViews:OfficeConversionWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfOrganizeWorkspaceViewModel}">
                        <workspaceViews:PdfOrganizeWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfCropWorkspaceViewModel}">
                        <workspaceViews:PdfCropWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfEditWorkspaceViewModel}">
                        <workspaceViews:PdfEditWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PdfCompareWorkspaceViewModel}">
                        <workspaceViews:PdfCompareWorkspaceView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workspaces:PendingWorkspaceViewModel}">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <Button Content="{x:Static project:Resources.CommonBackToHome}"
                                        Style="{StaticResource HubSecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,16"
                                        Command="{Binding BackCommand}" />
                                <TextBlock Text="{Binding Tool.Title}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Tool.Description}" FontSize="13.5" Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
