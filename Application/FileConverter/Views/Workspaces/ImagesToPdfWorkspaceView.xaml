<UserControl x:Class="FileConverter.Views.Workspaces.ImagesToPdfWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <CheckBox Content="Merge all selected images into a single PDF"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                  IsChecked="{Binding MergeIntoSinglePdf, Mode=TwoWay}" Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding MergeIntoSinglePdf, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                            <TextBlock Text="{x:Static project:Resources.CommonOutputFile}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernInputTextBox}"
                                     Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="Page Size" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Height="32" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Margin="0,0,0,10" />

                        <TextBlock Text="Orientation" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Height="32" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" Margin="0,0,0,10" />

                        <TextBlock Text="Margins" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Height="32" ItemsSource="{Binding Margins}" SelectedItem="{Binding Margin}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
