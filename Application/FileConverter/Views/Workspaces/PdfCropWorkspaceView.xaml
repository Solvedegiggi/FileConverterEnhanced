<UserControl x:Class="FileConverter.Views.Workspaces.PdfCropWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Interactive Page Preview & Crop Overlay -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"
                    AllowDrop="True" DragOver="PreviewArea_DragOver" Drop="PreviewArea_Drop">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="Open PDF..." Style="{StaticResource HubSecondaryButton}"
                                Command="{Binding BrowseFilesCommand}" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="◀" Width="32" Height="30" Padding="0" Style="{StaticResource HubSecondaryButton}"
                                    Command="{Binding PrevPageCommand}" />
                            <TextBlock Text="{Binding PageIndicatorText}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Content="▶" Width="32" Height="30" Padding="0" Style="{StaticResource HubSecondaryButton}"
                                    Command="{Binding NextPageCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Background="{DynamicResource SubtlePanelBrush}" CornerRadius="8" Padding="10">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}" Stretch="Uniform" />
                            <Canvas x:Name="CropOverlayCanvas"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    SizeChanged="CropOverlayCanvas_SizeChanged"
                                    MouseLeftButtonDown="CropOverlayCanvas_MouseDown"
                                    MouseMove="CropOverlayCanvas_MouseMove"
                                    MouseLeftButtonUp="CropOverlayCanvas_MouseUp">
                                <Rectangle x:Name="CropRectVisual"
                                           Stroke="#0171BB"
                                           StrokeThickness="2"
                                           StrokeDashArray="5 3"
                                           Fill="#220171BB"
                                           IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Crop Controls -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Crop Margins (mm)" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Content="Reset" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Style="{StaticResource HubSecondaryButton}" Padding="8,2" FontSize="11.5"
                                        Command="{Binding ResetMarginsCommand}" />
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Top (mm)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding TopMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Bottom (mm)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding BottomMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Left (mm)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding LeftMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Right (mm)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding RightMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Apply Crop Scope" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="All pages" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                         IsChecked="{Binding IsAllPages, Mode=TwoWay}" />
                            <RadioButton Content="Current page only" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                         IsChecked="{Binding IsCurrentPage, Mode=TwoWay}" />
                            <RadioButton Content="Custom page range" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                         IsChecked="{Binding IsCustomRange, Mode=TwoWay}" />
                            <TextBox Style="{StaticResource ModernInputTextBox}"
                                     Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
