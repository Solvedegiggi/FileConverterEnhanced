<UserControl x:Class="FileConverter.Views.Workspaces.PdfToJpgWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Extraction Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <RadioButton Content="Convert each PDF page to JPG"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding IsPagesToImages, Mode=TwoWay}" />
                        <RadioButton Content="Extract embedded images inside PDF"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"
                                     IsChecked="{Binding IsExtractEmbeddedImages, Mode=TwoWay}" />

                        <StackPanel Visibility="{Binding IsPagesToImages, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                            <TextBlock Text="Render DPI" FontSize="12.5" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox Height="32" ItemsSource="{Binding AvailableDpi}" SelectedItem="{Binding Dpi}" Margin="0,0,0,12" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="JPEG Quality" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding JpegQuality, StringFormat='{}{0}%'}" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </DockPanel>
                        <Slider Minimum="20" Maximum="100" Value="{Binding JpegQuality}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,14" />

                        <TextBlock Text="{x:Static project:Resources.CommonPages}" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
