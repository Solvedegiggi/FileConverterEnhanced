<UserControl x:Class="FileConverter.Views.Workspaces.PdfPageNumbersWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Position" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <UniformGrid Columns="3" Rows="2" Width="260" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <RadioButton Content="Top Left" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsTopLeft, Mode=TwoWay}" />
                                <RadioButton Content="Top Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsTopCenter, Mode=TwoWay}" />
                                <RadioButton Content="Top Right" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsTopRight, Mode=TwoWay}" />
                                <RadioButton Content="Bot Left" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsBottomLeft, Mode=TwoWay}" />
                                <RadioButton Content="Bot Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsBottomCenter, Mode=TwoWay}" />
                                <RadioButton Content="Bot Right" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" IsChecked="{Binding IsBottomRight, Mode=TwoWay}" />
                            </UniformGrid>

                            <TextBlock Text="Format ({n}, {total})" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox IsEditable="True" Height="32" ItemsSource="{Binding PresetFormats}"
                                      Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Font" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Height="32" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding FontFamily}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Size (pt)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding FontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Color (#hex)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding ColorHex}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start page" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding StartPage}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="First #" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding StartNumber}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Margin (mm)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding MarginMm}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Static project:Resources.CommonPages}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource ModernInputTextBox}" Text="{Binding PageRange}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
