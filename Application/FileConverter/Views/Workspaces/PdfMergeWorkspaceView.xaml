<UserControl x:Class="FileConverter.Views.Workspaces.PdfMergeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{x:Static project:Resources.CommonOutputFile}"
                                   FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=".pdf" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
