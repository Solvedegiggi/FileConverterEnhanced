<UserControl x:Class="FileConverter.Views.Workspaces.PdfRotateWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Rotation Angle" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <RadioButton Content="Rotate 90° Clockwise (Right)"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding IsRotate90Cw, Mode=TwoWay}" />
                        <RadioButton Content="Rotate 180° (Upside Down)"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding IsRotate180, Mode=TwoWay}" />
                        <RadioButton Content="Rotate 90° Counter-Clockwise (Left)"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"
                                     IsChecked="{Binding IsRotate90Ccw, Mode=TwoWay}" />

                        <TextBlock Text="{x:Static project:Resources.CommonPages}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
