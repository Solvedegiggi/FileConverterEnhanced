<UserControl x:Class="FileConverter.Views.Workspaces.HtmlToPdfWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{x:Static project:Resources.UniversalUrlLabel}"
                                   FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <workspaces:WorkspaceFileListControl />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Page Size" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Height="32" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Margin="0,0,0,10" />

                        <TextBlock Text="Orientation" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Height="32" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" Margin="0,0,0,12" />

                        <CheckBox Content="Print background graphics and colors"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="{Binding PrintBackground, Mode=TwoWay}" Margin="0,0,0,12" />

                        <TextBlock Text="Render wait delay after page load (ms)" FontSize="12.5" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
