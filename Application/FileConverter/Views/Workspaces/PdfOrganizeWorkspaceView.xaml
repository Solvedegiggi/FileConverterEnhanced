<UserControl x:Class="FileConverter.Views.Workspaces.PdfOrganizeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Page Cards Grid -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"
                    AllowDrop="True" DragOver="PagesArea_DragOver" Drop="PagesArea_Drop">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="+ Add PDF..." Style="{StaticResource HubPrimaryButton}"
                                    Padding="12,6" Margin="0,0,8,0"
                                    Command="{Binding BrowseFilesCommand}" />
                            <Button Content="{x:Static project:Resources.UniversalClearList}" Style="{StaticResource HubSecondaryButton}"
                                    Padding="10,6" Command="{Binding ClearPagesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Pages.Count, StringFormat='{}{0} pages'}" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="166" Height="244" Margin="0,0,12,12" Padding="8" CornerRadius="10"
                                            Background="{DynamicResource SubtlePanelBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="4" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding RotationDelta}" />
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>

                                            <TextBlock Grid.Row="1" Text="{Binding PageNumberLabel}" FontSize="11" Margin="0,6,0,4"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <UniformGrid Grid.Row="2" Columns="5">
                                                <Button Content="←" Height="26" Margin="1" Padding="0" FontSize="12"
                                                        Style="{StaticResource HubSecondaryButton}"
                                                        Command="{Binding DataContext.MovePageLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↻" Height="26" Margin="1" Padding="0" FontSize="12"
                                                        Style="{StaticResource HubSecondaryButton}"
                                                        Command="{Binding DataContext.RotatePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="⧉" Height="26" Margin="1" Padding="0" FontSize="11"
                                                        Style="{StaticResource HubSecondaryButton}"
                                                        Command="{Binding DataContext.DuplicatePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="→" Height="26" Margin="1" Padding="0" FontSize="12"
                                                        Style="{StaticResource HubSecondaryButton}"
                                                        Command="{Binding DataContext.MovePageRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" Height="26" Margin="1" Padding="0" FontSize="11"
                                                        Foreground="#DC2626" Style="{StaticResource HubSecondaryButton}"
                                                        Command="{Binding DataContext.DeletePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Output Settings -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel>
                        <TextBlock Text="{x:Static project:Resources.CommonOutputFile}"
                                   FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}"
                                 Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Blank uses original filename + unique suffix." FontSize="11.5" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
