<UserControl x:Class="FileConverter.Views.Workspaces.PdfOcrWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <CheckBox Content="Skip pages that already contain searchable text"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding SkipTextPages, Mode=TwoWay}" Margin="0,0,0,10" />
                            <DockPanel>
                                <TextBlock Text="OCR Render DPI:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ComboBox Width="110" Height="30" HorizontalAlignment="Left"
                                          ItemsSource="{Binding AvailableDpi}" SelectedItem="{Binding Dpi}" />
                            </DockPanel>
                            <TextBlock Text="OCR Languages" FontSize="13.5" FontWeight="SemiBold" Margin="0,12,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✓ Offline" Foreground="{DynamicResource SuccessForegroundBrush}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}" />
                                                <Button Content="Download" Style="{StaticResource HubSecondaryButton}"
                                                        Padding="8,2" FontSize="11.5"
                                                        Command="{Binding DataContext.DownloadLanguageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Visible;Collapsed}" />
                                            </StackPanel>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsInstalled}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
