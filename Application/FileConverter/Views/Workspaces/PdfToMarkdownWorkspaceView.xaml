<UserControl x:Class="FileConverter.Views.Workspaces.PdfToMarkdownWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Markdown Export Options" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <CheckBox Content="Extract embedded images to _assets subfolder"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                                  IsChecked="{Binding ExtractImages, Mode=TwoWay}" />

                        <CheckBox Content="Insert horizontal page break dividers (---)"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="{Binding IncludePageBreaks, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
