<UserControl x:Class="FileConverter.Views.Workspaces.PdfCompressWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Compression Level" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <RadioButton Content="Extreme Compression (smallest size, 72 DPI)"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                                     IsChecked="{Binding IsExtreme, Mode=TwoWay}" />
                        <RadioButton Content="Recommended Compression (good quality, 150 DPI)"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                                     IsChecked="{Binding IsRecommended, Mode=TwoWay}" />
                        <RadioButton Content="Less Compression (high quality, 300 DPI)"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsChecked="{Binding IsLow, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
