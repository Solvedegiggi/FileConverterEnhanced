<UserControl x:Class="FileConverter.Views.Workspaces.PdfSplitWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties"
             xmlns:workspaces="clr-namespace:FileConverter.Views.Workspaces">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <workspaces:WorkspaceHeaderControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <workspaces:WorkspaceFileListControl />
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <DockPanel>
                    <workspaces:WorkspaceOutputControl DockPanel.Dock="Bottom" />

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{Binding TotalPagesHint, StringFormat='Pages detected: {0}'}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource MainBrush}" />

                        <RadioButton Content="Split every page into separate PDF"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding IsSplitAllPages, Mode=TwoWay}" />
                        <RadioButton Content="Extract selected pages into one PDF"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding IsExtractRange, Mode=TwoWay}" />
                        <RadioButton Content="Split every N pages"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"
                                     IsChecked="{Binding IsSplitEveryN, Mode=TwoWay}" />

                        <TextBlock Text="{x:Static project:Resources.CommonPages}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource ModernInputTextBox}" Margin="0,0,0,12"
                                 Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsSplitEveryN, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
                            <TextBlock Text="Pages per file:" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox Width="80" Style="{StaticResource ModernInputTextBox}"
                                     Text="{Binding EveryNPages, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
