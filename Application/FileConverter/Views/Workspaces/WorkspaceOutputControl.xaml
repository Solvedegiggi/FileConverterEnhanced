<UserControl x:Class="FileConverter.Views.Workspaces.WorkspaceOutputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:FileConverter.Properties">
    <StackPanel>
        <TextBlock Text="{x:Static project:Resources.UniversalOutputDestination}"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="{x:Static project:Resources.UniversalSameFolder}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         IsChecked="{Binding UseCustomOutputFolder, Converter={StaticResource BoolInverter}}"
                         Margin="0,0,16,0" />
            <RadioButton Content="{x:Static project:Resources.UniversalCustomFolder}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         IsChecked="{Binding UseCustomOutputFolder}" />
        </StackPanel>
        <DockPanel Margin="0,0,0,12"
                   Visibility="{Binding UseCustomOutputFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
            <Button Content="{x:Static project:Resources.CommonBrowse}" DockPanel.Dock="Right"
                    Style="{StaticResource HubSecondaryButton}" Margin="8,0,0,0"
                    Command="{Binding BrowseOutputFolderCommand}" />
            <TextBox Style="{StaticResource ModernInputTextBox}"
                     Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ErrorForegroundBrush}"
                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=Collapsed}" />

        <Button Height="42"
                Content="{x:Static project:Resources.CommonStartProcess}"
                Style="{StaticResource HubPrimaryButton}"
                Command="{Binding ExecuteCommand}" />
    </StackPanel>
</UserControl>
