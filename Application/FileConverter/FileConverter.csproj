<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FileConverter</RootNamespace>
    <AssemblyName>FileConverter</AssemblyName>
    <ApplicationIcon>Resources\ApplicationIcon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <OutputPath>bin\x86\$(Configuration)\</OutputPath>
    <DefineConstants>$(DefineConstants);BUILD32</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="Application.xaml" />
    <ApplicationDefinition Include="Application.xaml" />
    <Resource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Markdown.Xaml">
      <HintPath>..\..\Middleware\Markdown.Xaml.dll</HintPath>
    </Reference>
    <Reference Include="PresentationUI" />
    <Reference Include="Ripper">
      <HintPath>..\..\Middleware\Ripper.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="yeti.mmedia">
      <HintPath>..\..\Middleware\yeti.mmedia.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileConverterExtension\FileConverterExtension.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.10.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="NetOffice.Excel" Version="1.7.4.11" />
    <PackageReference Include="NetOffice.PowerPoint" Version="1.7.4.11" />
    <PackageReference Include="NetOffice.Word" Version="1.7.4.11" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="SharpShell" Version="2.7.2" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <Target Name="CopyMiddlewareAndOrganizeLanguages" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\..\Middleware\ffmpeg\ffmpeg.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\..\Middleware\gs\gsdll64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\..\Middleware\gs\gswin64c.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Settings.default.xml" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <TessdataFiles Include="$(ProjectDir)..\..\Middleware\tessdata\*.traineddata" />
    </ItemGroup>
    <Copy SourceFiles="@(TessdataFiles)" DestinationFolder="$(TargetDir)tessdata\" SkipUnchangedFiles="true" Condition="'@(TessdataFiles)' != ''" />
    <ItemGroup>
      <SatelliteAssembliesToMove Include="$(TargetDir)*\$(TargetName).resources.dll" Exclude="$(TargetDir)Languages\**" />
    </ItemGroup>
    <Copy SourceFiles="@(SatelliteAssembliesToMove)" DestinationFiles="@(SatelliteAssembliesToMove->'$(TargetDir)Languages\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Delete Files="@(SatelliteAssembliesToMove)" />
  </Target>

</Project>
